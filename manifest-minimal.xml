<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xsi:type="MailApp">
  
  <Id>a811c8e3-5f6d-4c9b-9e2a-1d3c4b5a6e7f</Id>
  <Version>1.0.2.0</Version>
  <ProviderName>AssistDMS</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="AssistDMS Test"/>
  <Description DefaultValue="Test Add-in"/>
  
  <IconUrl DefaultValue="https://mlcoq.github.io/assistdms-admin/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://mlcoq.github.io/assistdms-admin/icon-80.png"/>
  <SupportUrl DefaultValue="https://mlcoq.github.io/assistdms-admin"/>
  
  <AppDomains>
    <AppDomain>https://mlcoq.github.io</AppDomain>
  </AppDomains>
  
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://mlcoq.github.io/assistdms-admin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  
  <Permissions>ReadWriteMailbox</Permissions>
  
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
</OfficeApp>
